{
  "name": "SlideLink",
  "short_name": "SlideLink",
  "description": "Live-synced presentations with phone remote and Claude",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14151c",
  "theme_color": "#14151c",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Remote",
      "url": "/remote"
    },
    {
      "name": "Library",
      "url": "/"
    },
    {
      "name": "Present",
      "url": "/present"
    }
  ]
}
